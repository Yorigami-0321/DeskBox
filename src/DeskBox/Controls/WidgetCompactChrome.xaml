<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetCompactChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:widgetContents="using:DeskBox.Controls.WidgetContents">
<Grid
            x:Name="CollapsedChromeLayer" x:FieldModifier="public"
            Grid.RowSpan="2"
            Canvas.ZIndex="45"
            Padding="8,0,6,0"
            Background="Transparent"
            Visibility="Collapsed"
            GotFocus="CollapsedChromeLayer_GotFocus"
            LostFocus="CollapsedChromeLayer_LostFocus"
            PointerCaptureLost="OverlayDragHandle_PointerCaptureLost"
            PointerMoved="OverlayDragHandle_PointerMoved"
            PointerPressed="OverlayDragHandle_PointerPressed"
            PointerReleased="OverlayDragHandle_PointerReleased"
            RightTapped="CollapsedChromeLayer_RightTapped"
            SizeChanged="CollapsedChromeLayer_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Color field gradient background (weather, todo, etc.) -->
            <Border x:Name="CompactColorField" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>
                    <LinearGradientBrush x:Name="CompactColorFieldBrush" x:FieldModifier="public" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="ColorFieldStop1" x:FieldModifier="public" Color="Transparent" Offset="0" />
                        <GradientStop x:Name="ColorFieldStop2" x:FieldModifier="public" Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Full-bleed background image (album art etc.) wrapped in clipping Border -->
            <Border x:Name="CompactFullBleedClip" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    IsHitTestVisible="False">
                <Image x:Name="CompactFullBleedBackground" x:FieldModifier="public"
                       Stretch="UniformToFill"
                       Opacity="0"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="FullBleedScaleTransform" x:FieldModifier="public" ScaleX="1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>
            </Border>

            <!-- Paused dim overlay (10% black when music paused) -->
            <Border x:Name="CompactPausedDim" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    Background="#1A000000"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <!-- Gradient overlay for text readability on full-bleed backgrounds.
                 Stop colors are theme-driven from code (dark scrim in dark theme,
                 light scrim in light theme). -->
            <Border x:Name="CompactFullBleedOverlay" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="CompactFullBleedStop0" x:FieldModifier="public" Color="#D9000000" Offset="0" />
                        <GradientStop x:Name="CompactFullBleedStop1" x:FieldModifier="public" Color="#8C000000" Offset="0.45" />
                        <GradientStop x:Name="CompactFullBleedStop2" x:FieldModifier="public" Color="#40000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Shimmer gradient (search capsule) -->
            <Border x:Name="CompactShimmer" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>
                    <LinearGradientBrush x:Name="CompactShimmerBrush" x:FieldModifier="public" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0063B1" Offset="0" />
                        <GradientStop Color="#8B5CF6" Offset="0.5" />
                        <GradientStop Color="#0063B1" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Particle canvas (rain, snow) -->
            <Canvas x:Name="CompactParticleCanvas" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    IsHitTestVisible="False" />

            <!-- Bottom glow bar (music playback) -->
            <Border x:Name="CompactBottomGlow" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Margin="6,0,6,1"
                    CornerRadius="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <!-- Edge glow border -->
            <Border x:Name="CompactEdgeGlow" x:FieldModifier="public"
                    Grid.ColumnSpan="4"
                    Margin="-8,0,-6,0"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="CompactEdgeGlowBrush" x:FieldModifier="public" Color="Transparent" />
                </Border.BorderBrush>
            </Border>

            <Grid
                x:Name="CompactIdentityHost" x:FieldModifier="public"
                Width="36"
                Height="28"
                VerticalAlignment="Center"
                Background="Transparent"
                RenderTransformOrigin="0.5,0.5"
                PointerEntered="CompactIdentityHost_PointerEntered"
                PointerExited="CompactIdentityHost_PointerExited">
                <Grid.RenderTransform>
                    <ScaleTransform
                        x:Name="CompactIdentityPulseTransform" x:FieldModifier="public"
                        ScaleX="1"
                        ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompactGroupPositionRailColumn" x:FieldModifier="public" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- A collapsed group always exposes its current position. This
                     is intentionally independent from the expanded title layout. -->
                <Grid
                    x:Name="CompactGroupPositionRailViewport" x:FieldModifier="public"
                    Grid.Column="0"
                    Width="5"
                    Height="20"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <StackPanel
                        x:Name="CompactGroupPositionRail" x:FieldModifier="public"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Vertical"
                        Spacing="2"
                        Visibility="Collapsed" />
                </Grid>

                <Grid
                    x:Name="CompactIdentityVisualHost" x:FieldModifier="public"
                    Grid.Column="1">
                    <controls:WidgetTitleIcon
                        x:Name="CompactTitleIcon" x:FieldModifier="public"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AccentColor="{x:Bind TitleIconAccentColor, Mode=OneWay}"
                        CustomEmoji="{x:Bind TitleIconCustomEmoji, Mode=OneWay}"
                        CustomImageSource="{x:Bind TitleIconCustomSource, Mode=OneWay}"
                        Glyph="{x:Bind TitleGlyph, Mode=OneWay}"
                        IconSize="14"
                        IconKind="{x:Bind TitleIconKind, Mode=OneWay}"
                        LabelText="{x:Bind OverlayTitle, Mode=OneWay}" />
                    <Image
                        x:Name="CompactIconImage" x:FieldModifier="public"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Stretch="Uniform" />
                    <Border
                        x:Name="CompactThumbnailHost" x:FieldModifier="public"
                        Width="28"
                        Height="28"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Image x:Name="CompactThumbnail" x:FieldModifier="public" Stretch="UniformToFill" />
                    </Border>
                    <!-- Rotating vinyl disc (music capsule only). Sits before the title text. -->
                    <Grid
                        x:Name="CompactVinylHost" x:FieldModifier="public"
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="CompactVinylRotateTransform" x:FieldModifier="public" Angle="0" />
                        </Grid.RenderTransform>
                        <!-- black disc body -->
                        <Ellipse Fill="#0B0B0B" />
                        <!-- concentric groove rings -->
                        <Ellipse Stroke="#222222" StrokeThickness="0.6" Margin="1.5" />
                        <Ellipse Stroke="#2B2B2B" StrokeThickness="0.5" Margin="3" />
                        <Ellipse Stroke="#1E1E1E" StrokeThickness="0.5" Margin="4.5" />
                        <!-- directional sheen -->
                        <Ellipse>
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.32,0.26" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
                                    <GradientStop Offset="0" Color="#55FFFFFF" />
                                    <GradientStop Offset="0.4" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- center label backing -->
                        <Ellipse Margin="6.5" Fill="#000000" />
                        <!-- center label = album cover -->
                        <Ellipse x:Name="CompactVinylLabel" x:FieldModifier="public" Margin="6.5">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="CompactVinylLabelBrush" x:FieldModifier="public" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- spindle hole -->
                        <Ellipse Width="1.6" Height="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#000000" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Stable left-side drag hit zone. It intentionally overlaps only
                 the leading edge of the text column so moving into the middle
                 body still switches to the expand interaction. The OS move
                 cursor set on this element is the drag affordance. -->
            <Border
                x:Name="CompactMoveHitRegion" x:FieldModifier="public"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="48"
                Height="34"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#01000000"
                Canvas.ZIndex="47"
                PointerEntered="CompactMoveHitRegion_PointerEntered"
                PointerExited="CompactMoveHitRegion_PointerExited" />

            <!-- Compact interaction hint. This is an in-tree visual rather than a
                 ToolTip popup, so WinUI cannot dismiss it while the pointer stays
                 in the capsule. It never participates in hit testing. -->
            <Border
                x:Name="CompactHintPresenter" x:FieldModifier="public"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="2,-34,0,0"
                Padding="8,5"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Canvas.ZIndex="120"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="CompactHintText" x:FieldModifier="public"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid
                x:Name="CompactTextContainer" x:FieldModifier="public"
                Grid.Column="1"
                MinWidth="0"
                Margin="4,0,6,0"
                VerticalAlignment="Stretch"
                Background="Transparent"
                PointerEntered="CompactTextContainer_PointerEntered"
                PointerExited="CompactTextContainer_PointerExited">
                <Border
                    x:Name="CompactTextHoverBackground" x:FieldModifier="public"
                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                    CornerRadius="4"
                    Opacity="0"
                    IsHitTestVisible="False" />
                <StackPanel
                    x:Name="CompactTextColumn" x:FieldModifier="public"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Spacing="4">
                <StackPanel
                    x:Name="CompactTextHost" x:FieldModifier="public"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="CompactTextTransform" x:FieldModifier="public" />
                    </StackPanel.RenderTransform>
                    <Grid x:Name="CompactTitleViewport" x:FieldModifier="public" Height="18">
                        <Grid x:Name="CompactTitleMarqueeTrack" x:FieldModifier="public">
                            <TextBlock
                                x:Name="CompactTitleText" x:FieldModifier="public"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CompactTitleMarqueeClone" x:FieldModifier="public"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextWrapping="NoWrap"
                                TextTrimming="Clip"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <Border
                        x:Name="CompactTextSeparator" x:FieldModifier="public"
                        Width="3"
                        Height="3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource TextFillColorTertiaryBrush}"
                        CornerRadius="2" />
                    <Grid x:Name="CompactSummaryViewport" x:FieldModifier="public" Height="17">
                        <Grid x:Name="CompactSummaryMarqueeTrack" x:FieldModifier="public">
                            <TextBlock
                                x:Name="CompactSummaryText" x:FieldModifier="public"
                                MinWidth="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CompactSummaryMarqueeClone" x:FieldModifier="public"
                                MinWidth="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextWrapping="NoWrap"
                                TextTrimming="Clip"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
            </StackPanel>
            <Grid
                x:Name="CompactMusicProgressHost" x:FieldModifier="public"
                Height="3"
                Margin="0,1,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <Border
                    x:Name="CompactMusicProgressTrack" x:FieldModifier="public"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    CornerRadius="1.5" />
                <Border
                    x:Name="CompactMusicProgressFill" x:FieldModifier="public"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="1.5"
                    RenderTransformOrigin="0,0.5"
                    IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="CompactMusicProgressTransform" x:FieldModifier="public" ScaleX="0" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
            </StackPanel>
            <Border
                x:Name="CompactBadge" x:FieldModifier="public"
                HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0"
                    Padding="5,1"
                    CornerRadius="7"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CompactBadgeText" x:FieldModifier="public"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>
            </Grid>

            <Border
                x:Name="CompactActionRegionHighlight" x:FieldModifier="public"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Width="24"
                Margin="0,0,-6,0"
                HorizontalAlignment="Right"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6,14,14,6"
                Canvas.ZIndex="40"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed" />

            <Border
                x:Name="CompactActionRegionTrigger" x:FieldModifier="public"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Width="32"
                HorizontalAlignment="Right"
                Background="#01000000"
                Canvas.ZIndex="41"
                PointerEntered="CompactActionRegionTrigger_PointerEntered"
                PointerExited="CompactActionRegionTrigger_PointerExited" />

            <Border
                x:Name="CompactReorderHandle" x:FieldModifier="public"
                Grid.Column="3"
                Width="18"
                Height="28"
                Margin="0,0,2,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#01000000"
                Canvas.ZIndex="44"
                Opacity="0"
                PointerEntered="CompactReorderHandle_PointerEntered"
                PointerExited="CompactReorderHandle_PointerExited"
                Visibility="Collapsed">
                <Grid
                    x:Name="CompactReorderGlyph" x:FieldModifier="public"
                    Width="7"
                    Height="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.58">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Column="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Row="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Row="2" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <StackPanel
                x:Name="CompactActionHost" x:FieldModifier="public"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Margin="0,0,2,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Canvas.ZIndex="43"
                Opacity="0"
                PointerEntered="CompactActionHost_PointerEntered"
                PointerExited="CompactActionHost_PointerExited"
                Spacing="2"
                IsHitTestVisible="False">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CompactActionHostTransform" x:FieldModifier="public" X="4" />
                </StackPanel.RenderTransform>
                <Button
                    x:Name="CompactPrimaryActionButton" x:FieldModifier="public"
                    Click="CompactPrimaryActionButton_Click"
                    Style="{StaticResource WidgetTitleActionButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon x:Name="CompactPrimaryActionIcon" x:FieldModifier="public" FontSize="12" Glyph="&#xE73E;" />
                </Button>
                <Button
                    x:Name="CompactPreviousButton" x:FieldModifier="public"
                    Click="CompactPreviousButton_Click"
                    Style="{StaticResource WidgetTitleActionButtonStyle}"
                    Visibility="Collapsed">
                    <widgetContents:MusicTransportIcon
                        Foreground="{Binding Foreground, ElementName=CompactPreviousButton}"
                        Kind="Previous" />
                </Button>
                <Button
                    x:Name="CompactPlayPauseButton" x:FieldModifier="public"
                    Click="CompactPlayPauseButton_Click"
                    Style="{StaticResource WidgetTitleActionButtonStyle}"
                    Visibility="Collapsed">
                    <widgetContents:MusicTransportIcon
                        x:Name="CompactPlayPauseIcon" x:FieldModifier="public"
                        Foreground="{Binding Foreground, ElementName=CompactPlayPauseButton}"
                        Kind="Play" />
                </Button>
                <Button
                    x:Name="CompactNextButton" x:FieldModifier="public"
                    Click="CompactNextButton_Click"
                    Style="{StaticResource WidgetTitleActionButtonStyle}"
                    Visibility="Collapsed">
                    <widgetContents:MusicTransportIcon
                        Foreground="{Binding Foreground, ElementName=CompactNextButton}"
                        Kind="Next" />
                </Button>
                <Button
                    x:Name="CompactExpandButton" x:FieldModifier="public"
                    Click="CompactExpandButton_Click"
                    Style="{StaticResource WidgetTitleActionButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>
            </StackPanel>

            <Grid
                x:Name="CompactLiveIndicatorHost" x:FieldModifier="public"
                Grid.ColumnSpan="4"
                Height="2"
                Margin="8,0,8,2"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
                <Border
                    x:Name="CompactLiveTrack" x:FieldModifier="public"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="1"
                    Opacity="0"
                    Visibility="Collapsed" />
                <Border
                    x:Name="CompactLiveProgress" x:FieldModifier="public"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="1"
                    Opacity="0"
                    RenderTransformOrigin="0,0.5"
                    Visibility="Collapsed">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="CompactLiveProgressTransform" x:FieldModifier="public" ScaleX="0" TranslateX="0" />
                    </Border.RenderTransform>
                </Border>
                <Border
                    x:Name="CompactLiveEventIndicator" x:FieldModifier="public"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="1"
                    Opacity="0" />
            </Grid>
        </Grid>
</UserControl>